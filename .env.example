# ─────────────────────────────────────────────────────────────
# Kignature LLC — Corporate Website · environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for metadataBase, sitemap.xml and robots.txt.
# Set this to the final public domain before deploying (e.g. https://kignature.com).
# Optional for local development (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact email shown in the Contact section.
# Leave empty/unset to hide the email and show the "channels being finalized" notice.
# Optional.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only webhook that receives contact-form submissions as JSON POST.
# Examples: a form endpoint (Formspree, Basin), a Slack/Discord incoming webhook,
# or your own backend endpoint. When unset, submissions are validated and
# logged in the dev-server console (placeholder mode — nothing is emailed).
# Optional — but required for the contact form to actually deliver messages.
CONTACT_WEBHOOK_URL=
